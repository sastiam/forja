{
  "permissions": {
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(~/.aws/**)", "Read(~/.ssh/**)",
      "Read(~/.config/op/**)", "Read(~/.config/forja/local/**)",
      "Edit(./.git/hooks/**)", "Edit(./.git/config)",
      "Bash(git push --force*)", "Bash(git push origin main*)"
    ],
    "allow": ["Bash(pnpm *)", "Bash(forja *)", "Bash(git status)", "Bash(git diff*)", "Bash(git commit*)"]
  },
{{- /* Dominios y lecturas: hosts/<host>.toml [claude] + perfil [claude] + módulos activos (forja apply → chezmoi.toml). */}}
{{- $sb := get . "claude_sandbox" | default dict }}
  "sandbox": {
    "enabled": {{ if hasKey $sb "enabled" }}{{ get $sb "enabled" }}{{ else }}true{{ end }},
    "failIfUnavailable": {{ if hasKey $sb "enabled" }}{{ get $sb "enabled" }}{{ else }}true{{ end }},
    "allowUnsandboxedCommands": false,
    "network": { "allowedDomains": {{ get $sb "allowed_domains" | default list | toJson }}{{ if and (has "containers" .modules) (eq .chezmoi.os "darwin") }},
      {{- /* Docker para agentes: la VM de Colima solo monta ~/code (ADR 0012). En Linux no se da el socket: el grupo docker equivale a root (ADR 0016). */}}
      "allowUnixSockets": [{{ printf "%s/.colima/default/docker.sock" .chezmoi.homeDir | toJson }}]{{ end }} },
    "filesystem": {
      "allowRead": {{ get $sb "allow_read" | default list | toJson }},
      "allowWrite": {{ get $sb "allow_write" | default list | toJson }}
    }
  },
  "hooks": {
    "Notification": [{ "hooks": [{ "type": "command", "command": "~/.claude/hooks/notify.sh" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "~/.claude/hooks/notify.sh done" }] }]{{ if and (has "containers" .modules) (eq .chezmoi.os "darwin") }},
    "PreToolUse": [{ "matcher": "Bash", "hooks": [{ "type": "command", "command": "~/.claude/hooks/colima-up.sh", "timeout": 120 }] }]{{ end }}{{ if has "worktrees" .modules }},
    "WorktreeCreate": [{ "hooks": [{ "type": "command", "command": "~/.claude/hooks/worktree-create.sh" }] }],
    "WorktreeRemove": [{ "hooks": [{ "type": "command", "command": "~/.claude/hooks/worktree-remove.sh" }] }]{{ end }}
  },
{{- /* Marketplaces y plugins (mods de plugins/, aws-core, codebase-memory): cli/src/core/claude-plugins.ts. */}}
  "extraKnownMarketplaces": {{ get . "claude_marketplaces" | default dict | toJson }},
  "enabledPlugins": {{ get . "claude_plugins" | default dict | toJson }},
  "statusLine": { "type": "command", "command": "~/.claude/statusline.sh" }{{ with get . "claude_model" }},
  "model": {{ toJson . }}{{ end }}{{ with get . "claude_theme" }},
  "theme": {{ toJson . }}{{ end }}{{ with get . "claude_overlay" }},
  {{- /* Capa personal (~/.config/forja/local/claude.settings.json): al final, así gana ante claves repetidas. */}}
  {{ . }}{{ end }}
}
