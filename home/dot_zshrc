# Gestionado por forja (módulo shell). Personaliza en ~/.config/forja/local/zshrc.local
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
export PATH="$HOME/.local/bin:$PATH"
[[ -d ~/.bun/bin ]] && export PATH="$HOME/.bun/bin:$PATH"   # bun link (módulo looper)
command -v mise >/dev/null && eval "$(mise activate zsh)"
command -v starship >/dev/null && eval "$(starship init zsh)"
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
command -v fzf >/dev/null && source <(fzf --zsh)
alias ls='eza --group-directories-first' cat='bat --paging=never' lg='lazygit'
export EDITOR="zed --wait"
# Completions de forja (módulo worktrees): VERIFICAR cuando exista `forja completion zsh`.
[[ -r ~/.config/forja/local/zshrc.local ]] && source ~/.config/forja/local/zshrc.local
