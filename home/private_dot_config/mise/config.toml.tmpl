[tools]
node = "26"          # Active LTS desde el 28-oct-2026
pnpm = "latest"
python = "3.13"
uv = "latest"
bun = "latest"       # openspec-cascade (módulo looper) pide Bun 1.4+
{{- if eq .chezmoi.os "linux" }}
# En Fedora estas herramientas no están en dnf; en macOS las instala el Brewfile del módulo agents/editor.
opencode = "latest"   # agents
rtk = "latest"        # agents (token-saver)
biome = "latest"      # editor
"npm:aws-cdk" = "latest"   # containers (en macOS: Brewfile)
{{- end }}
rust = "stable"      # uso ocasional; sin target-dir compartido, sin sccache por defecto
"npm:@fission-ai/openspec" = "2.1.0"    # CLI `openspec` de openspec-cascade (módulo looper)

[env]
OPENSPEC_TELEMETRY = "0"   # sin telemetría ni comprobación de versión; manda sobre `openspec config`

[settings]
idiomatic_version_file_enable_tools = ["node"]   # respeta .nvmrc / .node-version
