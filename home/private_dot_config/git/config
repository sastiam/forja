[init]
  defaultBranch = main
[core]
  pager = delta
  fsmonitor = true
  untrackedCache = true
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  side-by-side = true
[merge]
  conflictStyle = zdiff3
  tool = smerge
[mergetool "smerge"]
  cmd = smerge mergetool \"$BASE\" \"$LOCAL\" \"$REMOTE\" -o \"$MERGED\"
  trustExitCode = true
[mergetool]
  keepBackup = false
[merge "mergiraf"]
  name = mergiraf
  driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
[rerere]
  enabled = true
  autoUpdate = true
[extensions]
  worktreeConfig = true
[pull]
  rebase = true
[rebase]
  autoStash = true
  updateRefs = true
[fetch]
  prune = true
[diff]
  algorithm = histogram
  colorMoved = default
[include]
  path = ~/.config/forja/local/git.local.gitconfig
