// Gestionado por forja (módulo editor). Tareas globales: cmd-shift-p → "task: spawn".
[
  { "label": "pnpm test", "command": "pnpm", "args": ["-s", "test"], "cwd": "$ZED_WORKTREE_ROOT", "reveal": "always" },
  { "label": "pnpm typecheck", "command": "pnpm", "args": ["-s", "typecheck"], "cwd": "$ZED_WORKTREE_ROOT", "reveal": "no_focus" },
  { "label": "pnpm lint", "command": "pnpm", "args": ["-s", "lint"], "cwd": "$ZED_WORKTREE_ROOT", "reveal": "no_focus" },
  { "label": "forja wt ls", "command": "forja", "args": ["wt", "ls"], "cwd": "$ZED_WORKTREE_ROOT", "reveal": "always" },
  { "label": "forja wt integrate (rama actual)", "command": "sh", "args": ["-c", "forja wt integrate \"$(git branch --show-current)\""], "cwd": "$ZED_WORKTREE_ROOT", "reveal": "always" },
  { "label": "forja doctor", "command": "forja", "args": ["doctor"], "reveal": "always" }
]
